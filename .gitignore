# Generated by build / XcodeGen — source of truth is project.yml + Makefile.
# Regenerate with `make generate` (never commit these).
.build/
.swiftpm/
Package.resolved
*.xcodeproj/
# xcodegen generates Resources/Info.plist from project.yml's info.properties on
# every `make generate`; project.yml is the sole source of truth for it.
/Resources/Info.plist
DerivedData/

# macOS
.DS_Store

# Coverage / profiling artifacts
*.profraw
*.profdata

# Toolchain / build byproducts (created by CI or local runs, never committed):
# the opam local switch (setup-ocaml), the build-log tee'd by the build step, and
# the repository-local pinned XcodeGen (scripts/install-xcodegen.sh).
/_opam/
build.log
/.tools/

# Editor noise
*.swp
*~

# Local release artifacts (zipped .app for gh release)
dist/

# Built product site (scripts/build-site.py output)
/_site/
__pycache__/
