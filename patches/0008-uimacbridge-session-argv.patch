+(* unison-ui-mac extension (patch 0008): per-session command-line overrides.
+ * A graphical session may carry its own command-line option arguments (for
+ * example [-path Documents]) that scope only that session and are independent of
+ * the app's original process arguments. Swift stores the current session's
+ * argument vector here (via [unisonSetSessionArgs]) BEFORE calling [unisonInit1];
+ * [do_unisonInit1] then applies it through the engine's own parser
+ * ([Prefs.parseCmdLineArgs], patch 0007), after the profile is loaded and before
+ * the roots are validated and the connection is opened.
+ *
+ * The value is an OPTION so the engine can tell "no explicit session arguments
+ * supplied" (None -> parse the process command line on the first load, the
+ * legacy behavior) apart from "explicit session arguments, possibly empty"
+ * (Some v -> the caller owns this session's options; the process-launch argv is
+ * NOT also parsed, so list prefs cannot double up and unrequested launch options
+ * cannot leak in; an empty vector deliberately suppresses them and adds none).
+ *
+ * Storing is deliberately separate from applying: this setter ONLY records the
+ * vector -- it touches no preference -- so a queued request cannot mutate an
+ * active session's preferences. Application happens solely inside
+ * [do_unisonInit1], which the app reaches only when the engine is available for
+ * a fresh (re)load. Because [do_unisonInit1] runs [resetToDefaults] +
+ * [loadTheFile] on every re-entry (and [parseCmdLine] only on [firstTime]), the
+ * overrides are re-applied on every load, including a reconnecting rescan.
+ * NOT in upstream uimac -- local patch in this fork (patch 0008). *)
+let sessionArgs = ref (None : string array option)
+let unisonSetSessionArgs (args : string array) = sessionArgs := Some args
+;;
+Callback.register "unisonSetSessionArgs" unisonSetSessionArgs;;
+
+(* Test-only observability (patch 0008): a monotonic count of entries to the
+ * post-arguments connection-setup boundary in [do_unisonInit1] (root validation
+ * + [openConnectionStart]). Session arguments are applied strictly BEFORE this
+ * point, so a failed apply raises without advancing it, and a load that reaches
+ * connection setup does advance it. A test reads it across an operation to prove
+ * that a partial/failed argument apply started no connection or scan. Harmless
+ * in production (a plain counter, read only through a test bridge accessor). *)
+let connectSetupCount = ref 0
+;;
+Callback.register "unisonTestConnectSetupCount" (fun () -> !connectSetupCount);;
+
 let do_unisonInit1 profileName =
   (* Load the profile and command-line arguments *)
   (* Restore prefs to their default values, if necessary *)
@@ -255,20 +295,38 @@ let do_unisonInit1 profileName =
