 (*                            Printing                                       *)
 (*****************************************************************************)
diff --git a/src/ubase/prefs.mli b/src/ubase/prefs.mli
index 31a1e8c..69c723d 100644
--- a/src/ubase/prefs.mli
+++ b/src/ubase/prefs.mli
@@ -149,6 +149,19 @@ val parseCmdLineArgs :
   -> string array       (* Session option arguments (no leading program name) *)
   -> unit
 
+(* Whether a preference (by name or alias) is command-line-only, i.e. not      *)
+(* settable in a profile. Used to tell session-scoped options apart from        *)
+(* process-role options. False for an unknown name.                             *)
+val isCliOnly : string -> bool
+
+(* Extract the session-scoped (non-cli_only) options from a command line, as an *)
+(* ordered argv suitable for parseCmdLineArgs. argv includes the program name   *)
+(* (argv.(0)), which is dropped. Reuses the engine's own specs and parser;      *)
+(* preserves order, repeats, aliases, whitespace, and option-like values;       *)
+(* ignores anonymous arguments (profile/roots); sets no preference; raises      *)
+(* Util.Fatal on a parse error.                                                 *)
+val commandLineSessionArgs : string array -> string array
+
 (* Make a preliminary scan without setting any preferences                   *)
 (* Note: Command line include options are not processed; they will appear in *)
 (* the map.                                                                  *)
