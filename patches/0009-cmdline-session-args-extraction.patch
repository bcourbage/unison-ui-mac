@@ -263,6 +263,13 @@ let unisonSetSessionArgs (args : string array) = sessionArgs := Some args
 ;;
 Callback.register "unisonSetSessionArgs" unisonSetSessionArgs;;
 
+(* unison-ui-mac extension (patch 0009): expose the launch/request command
+ * line's session-scoped options (Prefs.commandLineSessionArgs over Sys.argv) so
+ * the app can deliver them to a session as explicit overrides. *)
+let unisonCommandLineSessionArgs () = Prefs.commandLineSessionArgs (System.argv ())
+;;
+Callback.register "unisonCommandLineSessionArgs" unisonCommandLineSessionArgs;;
