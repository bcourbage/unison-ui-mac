+(* Like [processCmdLine], but parse an explicit per-session argument vector
+   through the engine's own option specs, raising [Util.Fatal] on bad input
+   instead of exiting.  This is the session-request counterpart to
+   [parseCmdLine]: same parser, same arity, same list accumulation and
+   precedence, fed the request's arguments rather than [Sys.argv].  It does not
+   touch [Uarg.current]'s shared position. *)
+let processCmdLineArgs usage args hook =
+  let argspecs = argspecs hook in
+  let defaultanonfun _ =
+    raise (Util.Fatal "Anonymous arguments not allowed") in
+  let anonfun =
+    try
+      let {pspec = p; _} = Util.StringMap.find "rest" !prefs in
+      match hook "rest" p with
+        Uarg.String stringFunction -> stringFunction
+      | _                         -> defaultanonfun
+    with
+      Not_found -> defaultanonfun
+  in
+  try
+    Uarg.parseArgv args argspecs anonfun
+  with
+    IllegalValue str -> raise (Util.Fatal str)
+  | Uarg.Bad str     -> raise (Util.Fatal str)
+
+let parseCmdLineArgs usage args =
+  processCmdLineArgs usage args (fun _ sp -> sp)
+
 (* Scan command line without actually setting any preferences; return a      *)
 (* string map associating a list of strings with each option appearing on    *)
 (* the command line.                                                         *)
