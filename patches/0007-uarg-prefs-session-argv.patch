+(* Historical behavior: parse [Sys.argv], and on bad input print the message
+   and usage and [exit].  Byte-for-byte the same as before the [parseCore]
+   refactor. *)
+let parse speclist anonfun errmsg =
+  let argv = System.argv () in
+  let initpos = !current in
+  try parseCore argv speclist anonfun
+  with ParseError error ->
+    let progname =
+      if initpos < Array.length argv then argv.(initpos) else "(?)" in
+    begin match error with
+      | Unknown s when s = "-help" -> verify_stdout ()
+      | Unknown s ->
+          eprintf "%s: unknown option `%s'.\n" progname s
+      | Missing s ->
+          eprintf "%s: option `%s' needs an argument.\n" progname s
+      | Wrong (opt, arg, expected) ->
+          eprintf "%s: wrong argument `%s'; option `%s' expects %s.\n"
