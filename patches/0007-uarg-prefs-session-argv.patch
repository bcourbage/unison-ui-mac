+(* Parse an explicit argument vector (a session request), not [Sys.argv],
+   raising [Bad] on any error instead of exiting.  [args] holds only the option
+   words; a placeholder is prepended so [current]/[Rest] indexing matches the
+   [Sys.argv] convention (element 0 is the program name).  [current] is saved
+   and restored, so a session parse leaves the shared [Sys.argv] position
+   untouched. *)
+let parseArgv args speclist anonfun =
+  let argv = Array.append [| "" |] args in
+  let saved = !current in
+  current := 0;
+  match parseCore argv speclist anonfun with
+  | () -> current := saved
+  | exception ParseError error -> current := saved; raise (Bad (errorMessage error))
+  | exception e -> current := saved; raise e
+;;
