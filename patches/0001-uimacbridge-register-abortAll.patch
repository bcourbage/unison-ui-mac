+(* unison-ui-mac extension: real mid-sync abort.
+ *
+ * Sets `Abort.abortAll := true`, which causes the next call to
+ * `Abort.check` / `Abort.checkAll` inside the in-flight sync to raise
+ * `Util.Transient "Aborted by user request"`. The sync unwinds, in-
+ * progress file rows surface as FAILED via the existing progress
+ * callback path, and `syncComplete` fires once the worker has fully
+ * wound down. From the GUI's perspective this is the "Stop" toolbar
+ * action.
+ *
+ * NOT in upstream uimac — this is a local patch in this fork. The
+ * GUI project (unison-ui-mac) is deliberately not proposed upstream
+ * per Unison's CONTRIBUTING.md LLM-usage policy, so adding callbacks
+ * here is acceptable as long as we don't push the change back. *)
+let unisonAbortAll () = Abort.all ();;
+Callback.register "abortAll" unisonAbortAll;;
+
