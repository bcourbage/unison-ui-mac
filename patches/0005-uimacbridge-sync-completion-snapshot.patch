diff --git a/src/uimacbridge.ml b/src/uimacbridge.ml
--- a/src/uimacbridge.ml
+++ b/src/uimacbridge.ml
@@ -681,14 +681,23 @@
          (String.concat ", " (failures @ partials @ skipped)));
     initGlobalProgress Uutil.Filesize.dummy;
   end;;
-external syncComplete : unit -> unit = "syncComplete";;
+(* unison-ui-mac extension (patch 0005): syncComplete carries the final
+ * post-sync state array so the macOS bridge can marshal ONE bulk completion
+ * snapshot (each row's final progress + details) in a single call, instead of
+ * the UI making an O(n) series of per-row `unisonRiToDetails` bridge round-trips
+ * at completion time. The array is `!theState` AFTER do_unisonSynchronize has
+ * finalized every row's `whatHappened`, so the C side reads final values via
+ * the already-registered `unisonRiToProgress`/`unisonRiToDetails`/
+ * `unisonRiToBytesTransferred` accessors while the array is GC-rooted. No new
+ * OCaml allocation and no new failure path before the C completion protocol. *)
+external syncComplete : stateItem array -> unit = "syncComplete";;
 
 (* Do this in another thread and return immedidately to free up main thread in cocoa *)
 let unisonSynchronize () =
   doInOtherThread
     (fun () ->
        do_unisonSynchronize ();
-       syncComplete ())
+       syncComplete !theState)
 ;;
 Callback.register "unisonSynchronize" unisonSynchronize;;
 
