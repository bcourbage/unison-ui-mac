+(* Overridable hooks for tracking the exact transport (ssh) child PID.
+   Default no-ops so generic builds (CLI/GTK, no macOS bridge) link and behave
+   exactly as before. The macOS bridge installs real implementations backed by
+   a C-side, mutex-protected exact-PID registry that a pure-C shutdown path
+   reaps -- needed because the AppKit host can terminate the process without
+   running OCaml at_exit (so end_ssh never fires) and a wedged sync's ssh child
+   is blocked on the socket, so closing fds does not make it exit.
+
+   [registerTransportChild pid] records the child right after spawn.
+   [retireTransportChild pid] is called by teardown BEFORE it waitpid/
+   close_sessions the child: the bridge SIGKILLs the exact pid and removes it
+   from the registry atomically, so the child is already dead when it leaves
+   the registry (no live-untracked window) and no reused pid is ever signalled.
+   See docs/ssh-reaper-design.md in unison-ui-mac. *)
+let registerTransportChild : (int -> unit) ref = ref (fun _ -> ())
+let retireTransportChild : (int -> unit) ref = ref (fun _ -> ())
