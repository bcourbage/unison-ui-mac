+(* Install the exact transport-child (ssh) PID tracking hooks. These populate
+   a C-side, mutex-protected registry that a pure-C shutdown path reaps, so a
+   wedged connection's ssh child cannot survive app exit (the AppKit host
+   terminates without running OCaml at_exit). Only the macOS bridge references
+   these C symbols; generic remote.ml keeps its default no-op hooks. *)
+external unisonRegisterTransportChild : int -> unit = "unison_bridge_register_child";;
+external unisonUnregisterTransportChild : int -> unit = "unison_bridge_unregister_child";;
+Remote.registerTransportChild := unisonRegisterTransportChild;;
+Remote.unregisterTransportChild := unisonUnregisterTransportChild;;
