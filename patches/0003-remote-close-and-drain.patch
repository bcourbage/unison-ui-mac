    to close). *)
 val clientCloseRootConnection : Common.root -> unit
 
+(* Advance pending teardown of threads belonging to closed (or failed)
+   connections by driving the Lwt scheduler through a bounded number of
+   yields ([rounds] iterations, typically [Transport.maxThreads ()]).
+   Discarded threads otherwise resume during the next [Lwt_unix.run] and
+   can break a newly opened connection with their dying exceptions. This
+   does not prove that every thread has completed; it advances whatever
+   teardown is runnable now. Call this after closing a connection and
+   before opening another one in the same process.
+
+   Because this drives [Lwt_unix.run] (a single global scheduler), it must
+   not overlap another run of the scheduler -- not re-entrantly (from within
+   a running [Lwt_unix.run] callback) and not concurrently (another thread
+   in [Lwt_unix.run]); overlapping runs corrupt the scheduler. It may run on
+   any thread. Equivalently: call it only when the connection engine is
+   quiescent (no connect/scan/sync in flight). *)
+val drainDroppedConnectionThreads : rounds:int -> unit
+
 (* Statistics *)
 val emittedBytes : float ref
 val receivedBytes : float ref
diff --git a/src/test.ml b/src/test.ml
index 72e4714..12b66d9 100644
--- a/src/test.ml
+++ b/src/test.ml
@@ -247,6 +247,97 @@ type checkable = R1 | R2 | BACKUP1 | BACKUP2
 let checkable2string = function
   R1 -> "R1" | R2 -> "R2" | BACKUP1 -> "BACKUP1" | BACKUP2 -> "BACKUP2"
 
+(* Test repeated in-process connection lifecycle correctness: close a
+   remote connection and open a new one in the same process, several
+   times over. Graphical UIs do this when the user switches profiles (or
+   when the UI closes the connection between syncs). A thread belonging
+   to the closed connection that is still pending in the scheduler must
+   not break the next connection when it resumes; this is what
+   [Remote.drainDroppedConnectionThreads] (called here after each close,
+   the same way a UI should call it) guarantees. Without the drain, the
+   second cycle fails with "Lost connection with the server" /
+   "Protocol error: corrupted message received".
+
+   Uses the real shell-connection transport (child process plus pipes,
+   exactly the code path interactive UIs use), but with [sshcmd] pointing
+   at a wrapper script that ignores the ssh arguments and directly runs
+   this same executable as the server. Self-contained and deterministic:
+   no network, no ssh setup. Unix only (shell wrapper script). *)
+let testCloseReopen () =
+  Util.msg "Running connection close/reopen tests...\n";
+  (* Snapshot all preferences so we can restore them (we change [sshcmd]). *)
+  let origPrefs = Prefs.dump 1 in
+  let tdir =
+    let f = Filename.temp_file "unison-closereopen" "" in
+    Unix.unlink f; Unix.mkdir f 0o700; f
+  in
+  let servedRoot = Filename.concat tdir "root" in
+  Unix.mkdir servedRoot 0o700;
+  (* "ssh" replacement: ignore every argument (host, server command) and
+     exec this very binary in server mode on stdio. *)
+  let fakeSsh = Filename.concat tdir "fake-ssh" in
+  begin
+    let c = open_out fakeSsh in
+    output_string c
+      (Printf.sprintf "#!/bin/sh\nexec %s -server\n"
+         (Filename.quote Sys.executable_name));
+    close_out c;
+    Unix.chmod fakeSsh 0o700
+  end;
+  (* The connection opened in the current cycle. Tracked so exception
+     cleanup can close an established connection (each cycle normally
+     closes its own before the next one opens). *)
+  let openRoot = ref None in
+  let closeOpenRoot () =
+    match !openRoot with
+    | None -> ()
+    | Some root ->
+        openRoot := None;
+        (try Remote.clientCloseRootConnection root with _ -> ());
+        (try Remote.drainDroppedConnectionThreads
+               ~rounds:(Transport.maxThreads ())
+         with _ -> ())
+  in
+  let cleanup () =
+    closeOpenRoot ();
+    Prefs.load origPrefs 1;
+    begin try Unix.unlink fakeSsh with Unix.Unix_error _ -> () end;
+    begin try Unix.rmdir servedRoot with Unix.Unix_error _ -> () end;
+    begin try Unix.rmdir tdir with Unix.Unix_error _ -> () end
+  in
+  begin try
+    Prefs.loadStrings [Printf.sprintf "sshcmd = %s" fakeSsh];
+    let clroot =
+      Clroot.parseRoot (Printf.sprintf "ssh://testhost/%s" servedRoot) in
+    for i = 1 to 5 do
+      debug (fun () -> Util.msg "close/reopen cycle %d\n" i);
+      (* Open; the fake ssh never prompts. *)
+      begin match Remote.openConnectionStart clroot with
+      | None -> ()
+      | Some pre ->
+          begin match Remote.openConnectionPrompt pre with
+          | Some _ ->
+              Remote.openConnectionCancel pre;
+              raise (Util.Fatal "close/reopen test: unexpected prompt")
+          | None -> Remote.openConnectionEnd pre
+          end
+      end;
+      let root = Remote.canonize clroot in
+      openRoot := Some root;
+      (* A round trip over the new connection must succeed. *)
+      ignore (Lwt_unix.run (getfs root ()));
+      (* Close, then advance the closed connection's pending teardown
+         before the next cycle opens a new connection. *)
+      Remote.clientCloseRootConnection root;
+      openRoot := None;
+      Remote.drainDroppedConnectionThreads ~rounds:(Transport.maxThreads ())
+    done;
+    cleanup ()
+  with e ->
+    cleanup ();
+    raise e
+  end
+
 let test() =
   Util.warnPrinter := None;
   Prefs.set Trace.logging false;
@@ -269,6 +360,11 @@ let test() =
 
   Util.msg "Running internal tests...\n";
 
+  (* Self-contained (server runs as a child process communicating over its
+     stdio pipes, via a fake-ssh wrapper); does not touch the profile's
+     roots. Restores any preferences it changes. Unix only. *)
+  if Sys.os_type = "Unix" then testCloseReopen ();
+
   (* Paranoid checks, to make sure we do not delete anybody's filesystem! *)
   if not (Safelist.for_all
             (fun r -> Util.findsubstring "test" r <> None)
