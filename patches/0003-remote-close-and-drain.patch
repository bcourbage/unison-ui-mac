diff --git a/src/remote.ml b/src/remote.ml
index 2302b62..6a4807d 100644
--- a/src/remote.ml
+++ b/src/remote.ml
@@ -646,6 +646,42 @@ let clientCloseRootConnection = function
       | None -> ()
       end
 
+(* After a connection has been closed (by [clientCloseRootConnection] or by
+   a failure), threads belonging to it that were in the middle of execution
+   are just discarded. They are not gone, however: they resume the next time
+   [Lwt_unix.run] is called and typically terminate by raising an uncaught
+   exception ("Lost connection with the server"). If by then another
+   connection has been opened, that exception ends the *new* connection's
+   [Lwt_unix.run], breaking it.
+
+   This function advances such pending teardown by driving the scheduler
+   through a bounded number of yields, so discarded threads can finish
+   (their exceptions are caught and dropped here) before another connection
+   is opened. This must be done in a loop since each failing thread may
+   raise an uncaught exception which will end [Lwt_unix.run]. We don't know
+   how many threads can finish this way, so we don't know when to stop
+   looping; callers pass a bound (typically [Transport.maxThreads ()],
+   which is probably much more than needed). This does not guarantee that
+   every thread in existence has completed -- a thread still blocked on I/O
+   will not finish here; it advances whatever teardown is runnable now.
+
+   Scheduler-safety contract: this drives [Lwt_unix.run], and Unison's Lwt
+   scheduler is a single global instance, so this call must not overlap any
+   other run of the scheduler -- neither re-entrantly (do not call it from
+   within a callback of an already-running [Lwt_unix.run]) nor concurrently
+   (no other thread may be executing [Lwt_unix.run] while this runs). Two
+   overlapping [Lwt_unix.run] invocations corrupt the scheduler. It does
+   not matter which thread makes the call. Equivalently: call this only
+   when the connection engine is quiescent -- no connect/scan/sync in
+   flight -- which is exactly the state right after closing a connection. *)
+let drainDroppedConnectionThreads ~rounds =
+  let rec loop_yield n () =
+    if n = 0 then Lwt.return () else Lwt_unix.yield () >>= loop_yield (n - 1)
+  in
+  for _ = 1 to rounds do
+    try Lwt_unix.run (loop_yield 10 ()) with _ -> ()
+  done
+
 (****)
 
